#!/usr/bin/env bash
# blossom-shell — a reversible bash <-> zsh switcher with a Blossom-themed zsh.
#
#   blossom-shell enable      set up the themed zsh (config + plugins) and point
#                             kitty at it. Backs up anything it touches. Does NOT
#                             change your default shell.
#   blossom-shell try         open a Blossom zsh in a subshell (no install needed);
#                             `exit` returns you to bash.
#   blossom-shell default zsh|bash   change your login shell (asks for password).
#   blossom-shell disable     undo everything: restore backups, unpoint kitty.
#   blossom-shell status      what's installed / active right now.
#   blossom-shell doctor      health checks (incl. zsh -n lint of the config).
#   blossom-shell build-zsh   compile zsh into ~/.local (no sudo) if you lack one.
#   blossom-shell system-link    point /bin/zsh at your zsh so tools/IDEs that
#                             hard-code that path can spawn it (asks for password).
#   blossom-shell system-unlink  remove that /bin/zsh link.
#
# Design rule: bash is never modified. Everything is backed up before it changes,
# and `disable` puts it all back.
set -uo pipefail

APP_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SHELL_SRC="$APP_DIR/shell"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/blossom-shell"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/blossom-shell"
PLUGDIR="$DATA/plugins"
BACKUPS="$STATE/backups"
KITTY_CONF="$HOME/.config/kitty/kitty.conf"
MARK_BEGIN="# >>> blossom-shell >>>"
MARK_END="# <<< blossom-shell <<<"
MANAGED=("$HOME/.zshrc" "$HOME/.zprofile")
# How we escalate for the (rare) system-touching commands. Defaults to a normal
# interactive sudo; override (e.g. for non-interactive use) with SUDO=… in the env.
SUDO="${SUDO:-sudo}"

# --- Blossom palette for our own output ---
PINK=$'\e[38;2;219;55;118m'; GOLD=$'\e[38;2;241;191;64m'; BLUE=$'\e[38;2;54;200;255m'
RED=$'\e[38;2;236;78;83m';  GREEN=$'\e[38;2;55;255;160m'; DIM=$'\e[2m'; B=$'\e[1m'; R=$'\e[0m'
say()  { printf '%s\n' "$*"; }
ok()   { printf '  %s✓%s %s\n' "$GREEN" "$R" "$*"; }
warn() { printf '  %s!%s %s\n' "$GOLD" "$R" "$*"; }
err()  { printf '  %s✗%s %s\n' "$RED" "$R" "$*" >&2; }
hdr()  { printf '\n%s%s❀ %s%s\n' "$B" "$PINK" "$*" "$R"; }

zsh_bin() { command -v zsh 2>/dev/null || true; }
ts()      { date +%Y%m%d-%H%M%S; }
is_ours() { [ -e "$1" ] && grep -q "blossom-shell" "$1" 2>/dev/null; }

strip_block() {  # strip_block <file> — remove our marker block in place
  local f="$1"; [ -f "$f" ] || return 0
  awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
    $0==b {skip=1} !skip {print} $0==e {skip=0}' "$f" > "$f.bstmp" && mv "$f.bstmp" "$f"
}

# ---------------------------------------------------------------- enable -----
backup_existing() {
  local dir="$BACKUPS/$(ts)" did=0
  mkdir -p "$dir"
  for f in "${MANAGED[@]}"; do
    if [ -e "$f" ] && ! is_ours "$f"; then
      cp -a "$f" "$dir/$(basename "$f")"; did=1; ok "backed up $(basename "$f")"
    fi
  done
  getent passwd "$USER" | cut -d: -f7 > "$STATE/original-login-shell" 2>/dev/null || true
  if [ "$did" = 1 ]; then echo "$dir" > "$STATE/last-backup"; else rmdir "$dir" 2>/dev/null || true; fi
}

write_dotfiles() {
  cat > "$HOME/.zprofile" <<EOF
$MARK_BEGIN
# Generated by blossom-shell. Undo with: blossom-shell disable
export BLOSSOM_SHELL_HOME="$APP_DIR"
[ -f "\$BLOSSOM_SHELL_HOME/shell/env.zsh" ] && source "\$BLOSSOM_SHELL_HOME/shell/env.zsh"
$MARK_END
EOF
  cat > "$HOME/.zshrc" <<EOF
$MARK_BEGIN
# Generated by blossom-shell. Undo with: blossom-shell disable
export BLOSSOM_SHELL_HOME="$APP_DIR"
source "\$BLOSSOM_SHELL_HOME/shell/init.zsh"
$MARK_END
EOF
  ok "wrote ~/.zshrc and ~/.zprofile"
}

plugins_install() {
  mkdir -p "$PLUGDIR"
  local name url
  while read -r name url; do
    [ -z "$name" ] && continue
    if [ -d "$PLUGDIR/$name/.git" ]; then ok "plugin present: $name"
    else
      printf '  %s…%s cloning %s\n' "$DIM" "$R" "$name"
      if git clone --depth=1 -q "$url" "$PLUGDIR/$name" 2>/dev/null; then ok "cloned $name"
      else warn "couldn't clone $name (offline?) — shell still works, just without it"; fi
    fi
  done <<'PLUGS'
zsh-autosuggestions https://github.com/zsh-users/zsh-autosuggestions
zsh-syntax-highlighting https://github.com/zsh-users/zsh-syntax-highlighting
zsh-history-substring-search https://github.com/zsh-users/zsh-history-substring-search
fzf-tab https://github.com/Aloxaf/fzf-tab
zsh-completions https://github.com/zsh-users/zsh-completions
zsh-autopair https://github.com/hlissner/zsh-autopair
you-should-use https://github.com/MichaelAquilina/zsh-you-should-use
PLUGS
}

kitty_point() {
  [ -f "$KITTY_CONF" ] || { warn "no kitty.conf — skipping kitty integration"; return; }
  local zb; zb="$(zsh_bin)"; [ -z "$zb" ] && { warn "no zsh yet — kitty left as-is"; return; }
  if is_ours "$KITTY_CONF"; then strip_block "$KITTY_CONF"; fi
  mkdir -p "$BACKUPS"; cp -a "$KITTY_CONF" "$BACKUPS/$(ts)-kitty.conf"
  printf '\n%s\n# new kitty windows launch zsh while you trial it\nshell %s\n%s\n' \
    "$MARK_BEGIN" "$zb" "$MARK_END" >> "$KITTY_CONF"
  ok "kitty: new windows will open zsh"
}

cmd_enable() {
  hdr "Enabling blossom-shell  (bash stays default — fully reversible)"
  mkdir -p "$STATE" "$DATA"
  local zb; zb="$(zsh_bin)"
  if [ -z "$zb" ]; then
    warn "zsh isn't installed yet. Get it with either:"
    say  "      ${BLUE}sudo apt install zsh${R}        (system-wide)"
    say  "      ${BLUE}blossom-shell build-zsh${R}     (compiles into ~/.local, no sudo)"
  else ok "using zsh: $zb ($("$zb" --version 2>/dev/null | awk '{print $2}'))"; fi
  backup_existing
  write_dotfiles
  plugins_install
  kitty_point
  echo enabled > "$STATE/state"
  hdr "Done — try it without committing:"
  say "      ${BLUE}blossom-shell try${R}    ${DIM}# Blossom zsh subshell; 'exit' returns to bash${R}"
  say "  …or open a new kitty window (now zsh)."
  say "  Make it your default:  ${BLUE}blossom-shell default zsh${R}"
  say "  Undo all of it:        ${BLUE}blossom-shell disable${R}"
}

# --------------------------------------------------------------- disable -----
cmd_disable() {
  hdr "Disabling blossom-shell"
  for f in "${MANAGED[@]}"; do
    if is_ours "$f"; then rm -f "$f"; ok "removed generated $(basename "$f")"; fi
  done
  if [ -f "$STATE/last-backup" ]; then
    local dir; dir="$(cat "$STATE/last-backup")"
    for f in "${MANAGED[@]}"; do
      local b="$dir/$(basename "$f")"
      [ -e "$b" ] && cp -a "$b" "$f" && ok "restored your original $(basename "$f")"
    done
  fi
  if is_ours "$KITTY_CONF"; then strip_block "$KITTY_CONF"; ok "kitty: removed zsh launch line"; fi
  echo disabled > "$STATE/state"
  local cur; cur="$(getent passwd "$USER" | cut -d: -f7)"
  if [[ "$cur" == *zsh* ]]; then
    warn "your login shell is still zsh — switch back with: ${BLUE}blossom-shell default bash${R}"
  fi
  if [ -f "$STATE/system-link" ] && [ -L "$(cat "$STATE/system-link")" ]; then
    warn "the system /bin/zsh link is still in place — remove it with: ${BLUE}blossom-shell system-unlink${R}"
  fi
  ok "done. bash was never touched; new terminals use your restored setup."
}

# --------------------------------------------------------------- default -----
cmd_default() {
  case "${1:-}" in
    zsh)
      local zb; zb="$(zsh_bin)"; [ -z "$zb" ] && { err "no zsh installed (try: blossom-shell build-zsh)"; return 1; }
      if ! grep -qx "$zb" /etc/shells 2>/dev/null; then
        warn "$zb is not in /etc/shells, so chsh will reject it. Add it first:"
        say  "      ${BLUE}echo $zb | sudo tee -a /etc/shells${R}"
        return 1
      fi
      say "Changing your login shell to zsh (you'll be prompted for your password)…"
      chsh -s "$zb" && ok "default shell is now zsh — log out/in for everything to pick it up"
      ;;
    bash)
      say "Changing your login shell back to bash…"
      chsh -s /bin/bash && ok "default shell is now bash"
      ;;
    *) err "usage: blossom-shell default <zsh|bash>"; return 1 ;;
  esac
}

# --------------------------------------------------------- system-link -----
# Some tools (IDEs, editors, launchers) hard-code the path /bin/zsh. When zsh
# lives in ~/.local (e.g. built by build-zsh) that path doesn't exist and they
# fail with ENOENT. This points the canonical system path at your real zsh; /bin
# is a symlink to /usr/bin here, so linking /usr/bin/zsh makes /bin/zsh work too.
# It's a *symlink*, so future `build-zsh` rebuilds are picked up automatically,
# and your tweaks live in ~/.zshrc — read no matter which path launched zsh.
cmd_system_link() {
  hdr "Linking the system zsh so /bin/zsh works (asks for your password)"
  local zb; zb="$(zsh_bin)"; [ -z "$zb" ] && { err "no zsh installed (try: blossom-shell build-zsh)"; return 1; }
  local target; target="$(readlink -f "$zb")"
  local canon=/usr/bin/zsh
  if [ "$target" = "$canon" ]; then ok "zsh is already the system zsh ($canon) — nothing to do."; return 0; fi
  if [ -e "$canon" ] && [ ! -L "$canon" ]; then
    warn "$canon already exists as a real file (a system package?) — leaving it untouched."
    say  "      tools can use it as-is; nothing for blossom-shell to do here."
    return 0
  fi
  mkdir -p "$STATE"
  if $SUDO ln -sfn "$target" "$canon"; then ok "linked $canon → $target"; echo "$canon" > "$STATE/system-link"
  else err "couldn't create $canon"; return 1; fi
  : > "$STATE/system-shells"
  for s in /usr/bin/zsh /bin/zsh; do            # register both spellings as valid login shells
    grep -qx "$s" /etc/shells 2>/dev/null && continue
    if printf '%s\n' "$s" | $SUDO tee -a /etc/shells >/dev/null; then ok "registered $s in /etc/shells"; echo "$s" >> "$STATE/system-shells"; fi
  done
  hdr "Done — tools that hard-code /bin/zsh will find it now."
  say "  It's a symlink, so ${BLUE}blossom-shell build-zsh${R} rebuilds are picked up automatically."
  say "  Undo with: ${BLUE}blossom-shell system-unlink${R}"
}

# ------------------------------------------------------- system-unlink -----
cmd_system_unlink() {
  hdr "Removing the system /bin/zsh link (asks for your password)"
  local canon=/usr/bin/zsh
  [ -f "$STATE/system-link" ] && canon="$(cat "$STATE/system-link")"
  if [ -L "$canon" ] && [[ "$(readlink -f "$canon")" == "$HOME/.local/"* ]]; then
    $SUDO rm -f "$canon" && ok "removed symlink $canon"
  elif [ -L "$canon" ]; then
    warn "$canon points outside your home ($(readlink -f "$canon")) — not ours, leaving it."
  else
    warn "no blossom-made $canon symlink found — nothing to remove."
  fi
  rm -f "$STATE/system-link"
  if [ -f "$STATE/system-shells" ]; then
    while read -r s; do
      [ -z "$s" ] && continue
      $SUDO sed -i "\\|^$s\$|d" /etc/shells && ok "removed $s from /etc/shells"
    done < "$STATE/system-shells"
    rm -f "$STATE/system-shells"
  fi
  ok "done."
}

# ------------------------------------------------------------------- try -----
cmd_try() {
  local zb; zb="$(zsh_bin)"; [ -z "$zb" ] && { err "no zsh installed (try: blossom-shell build-zsh)"; return 1; }
  local td; td="$(mktemp -d)"
  cat > "$td/.zshrc" <<EOF
export BLOSSOM_SHELL_HOME="$APP_DIR"
source "$APP_DIR/shell/init.zsh"
EOF
  cp "$td/.zshrc" "$td/.zprofile"
  printf '%s── Blossom zsh ── type %sexit%s to return to bash ──%s\n' "$DIM" "$B" "$R$DIM" "$R"
  ZDOTDIR="$td" "$zb" -i -l
  rm -rf "$td"
  say "${DIM}back in bash.${R}"
}

# ---------------------------------------------------------------- status -----
cmd_status() {
  hdr "blossom-shell status"
  local login; login="$(getent passwd "$USER" | cut -d: -f7)"
  printf '  login shell : %s\n' "$login"
  printf '  zsh         : %s\n' "$(zsh_bin || echo 'not installed')"
  printf '  config      : %s\n' "$(is_ours "$HOME/.zshrc" && echo 'installed (~/.zshrc is ours)' || echo 'not installed')"
  printf '  kitty       : %s\n' "$(is_ours "$KITTY_CONF" && echo 'launches zsh' || echo 'unchanged')"
  printf '  system link : %s\n' "$([ -L /usr/bin/zsh ] && echo "/bin/zsh → $(readlink -f /usr/bin/zsh)" || echo 'none (IDEs that hard-code /bin/zsh will fail)')"
  printf '  plugins     : '
  if [ -d "$PLUGDIR" ]; then ls "$PLUGDIR" 2>/dev/null | tr '\n' ' '; echo; else echo 'none'; fi
  [ -f "$STATE/last-backup" ] && printf '  backup      : %s\n' "$(cat "$STATE/last-backup")"
  return 0   # a missing last-backup is normal, not an error — don't leak nonzero
}

# ---------------------------------------------------------------- doctor -----
cmd_doctor() {
  hdr "blossom-shell doctor"
  local fail=0 zb; zb="$(zsh_bin)"
  if [ -n "$zb" ]; then ok "zsh found: $zb"; else warn "zsh not installed"; fi
  # lint every config file with zsh -n
  if [ -n "$zb" ]; then
    local f
    for f in env.zsh options.zsh aliases.zsh prompt.zsh plugins.zsh init.zsh; do
      if "$zb" -n "$SHELL_SRC/$f" 2>/tmp/bs_lint.$$; then ok "syntax ok: shell/$f"
      else err "syntax error in shell/$f:"; sed 's/^/      /' /tmp/bs_lint.$$; fail=1; fi
    done
    rm -f /tmp/bs_lint.$$
  else warn "skipping syntax lint (no zsh)"; fi
  for p in zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search fzf-tab \
           zsh-completions zsh-autopair you-should-use; do
    [ -d "$PLUGDIR/$p" ] && ok "plugin: $p" || warn "plugin missing: $p (run: blossom-shell enable)"
  done
  is_ours "$HOME/.zshrc" && ok "config installed (~/.zshrc is ours)" || warn "not enabled yet (run: blossom-shell enable)"
  if [ -L /usr/bin/zsh ]; then ok "system link: /bin/zsh → $(readlink -f /usr/bin/zsh)"
  else warn "no /bin/zsh link — IDEs/tools that hard-code it will fail (run: blossom-shell system-link)"; fi
  [ "$fail" = 0 ] && printf '\n  %sall good%s\n' "$GREEN" "$R" || printf '\n  %sissues found above%s\n' "$RED" "$R"
  return "$fail"
}

# ------------------------------------------------------------- build-zsh -----
# Source mirrors for the zsh tarball, tried in order. zsh.org/pub used to host
# these but now 404s, so SourceForge (which redirects to a live mirror, hence
# curl -L) is the reliable primary and Fossies is a stable archival fallback.
ZSH_VER=5.9
ZSH_URLS=(
  "https://sourceforge.net/projects/zsh/files/zsh/${ZSH_VER}/zsh-${ZSH_VER}.tar.xz/download"
  "https://fossies.org/linux/misc/zsh-${ZSH_VER}.tar.xz"
  "https://www.zsh.org/pub/zsh-${ZSH_VER}.tar.xz"
)

cmd_build_zsh() {
  # No-sudo command: it installs into ~/.local. Running it under sudo resets HOME
  # to root's, hides an existing ~/.local/bin/zsh, and installs to the wrong place
  # — which is exactly how this fails. Refuse early with guidance.
  if [ "$(id -u)" = 0 ] || [ -n "${SUDO_USER:-}" ]; then
    err "don't run build-zsh with sudo — it installs into ~/.local (no root needed)."
    warn "run it as yourself:  ./blossom-shell build-zsh"
    return 1
  fi
  local existing; existing="$(zsh_bin)"
  [ -n "$existing" ] && { ok "zsh already available: $existing"; return 0; }
  command -v gcc >/dev/null && command -v make >/dev/null || { err "need gcc + make to build zsh"; return 1; }
  hdr "Building zsh ${ZSH_VER} into ~/.local (no sudo)"
  local d; d="$(mktemp -d)"
  ( set -e; cd "$d"
    got=0
    for url in "${ZSH_URLS[@]}"; do
      say "  fetching ${url%%/download}"
      # validate it's a real tarball, not a 404 page saved to disk
      if curl -fsSL "$url" -o z.tar.xz && tar tf z.tar.xz >/dev/null 2>&1; then got=1; break; fi
    done
    [ "$got" = 1 ] || { echo "could not download zsh ${ZSH_VER} source from any mirror" >&2; exit 1; }
    tar xf z.tar.xz; cd "zsh-${ZSH_VER}"
    ./configure --prefix="$HOME/.local" --disable-gdbm --with-tcsetpgrp >/dev/null
    make -j"$(nproc)" >/dev/null; make install >/dev/null
  ) && ok "installed: $HOME/.local/bin/zsh" || err "build failed"
  rm -rf "$d"
}

usage() {
  sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-help}" in
  enable)    cmd_enable ;;
  disable)   cmd_disable ;;
  try)       cmd_try ;;
  default)   cmd_default "${2:-}" ;;
  system-link)   cmd_system_link ;;
  system-unlink) cmd_system_unlink ;;
  status)    cmd_status ;;
  doctor)    cmd_doctor ;;
  build-zsh) cmd_build_zsh ;;
  help|-h|--help) usage ;;
  *) err "unknown command: $1"; usage; exit 1 ;;
esac
